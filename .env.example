# Variables de entorno de ejemplo — Kitchi Studio
# Copiar a .env en la RAÍZ del repositorio y completar con valores locales.
# NUNCA commitear el archivo .env real.
# Django carga este archivo con python-dotenv desde backend/config/settings.py.
# Los nombres definitivos se fijaron al implementar el backend (4 de noviembre de 2026).

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings
# Generar una clave propia, p. ej.: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=cambiar-esto
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos ---
# mysql (por defecto) o sqlite. Con sqlite el archivo queda en storage/kitchi.sqlite3
# y sirve para equipos donde MySQL no se pueda instalar (ADR-005).
DB_ENGINE=mysql
DB_NAME=Kitchi_db
DB_USER=cambiar-esto
DB_PASSWORD=cambiar-esto
DB_HOST=127.0.0.1
DB_PORT=3306

# --- CORS (Flet Web local) ---
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8550,http://localhost:8550

# --- Límites de negocio ---
# Plan gratuito del MVP: número máximo de gatos guardados por cuenta.
MAX_CATS_PER_USER=3

# --- IA (proveedor por decidir en ADR-003) ---
# La clave debe permanecer en el backend; jamás en el código de la interfaz ni en el repositorio.
# Con AI_PROVIDER=none la API sigue funcionando y el flujo de IA usa la contingencia documentada.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=60

# --- Subida de archivos ---
MAX_UPLOAD_SIZE_MB=5
ALLOWED_IMAGE_EXTENSIONS=png,jpg,jpeg

# --- Datos de demostración ---
# Contraseña de las cuentas creadas por scripts/seed_demo_data.py. No usar en producción.
DEMO_USER_PASSWORD=cambiar-esto

# --- Frontend (Flet) ---
API_BASE_URL=http://127.0.0.1:8000
