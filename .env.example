# Variables de entorno de ejemplo — Kitchi Studio
# Copiar a .env y completar con valores locales. NUNCA commitear el archivo .env real.
# Django carga estas variables con python-dotenv. Los nombres definitivos se fijan en P11.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=cambiar-esto
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- MySQL ---
DB_ENGINE=mysql
DB_NAME=kitchi_dev
DB_USER=cambiar-esto
DB_PASSWORD=cambiar-esto
DB_HOST=127.0.0.1
DB_PORT=3306

# --- CORS (Flet Web local) ---
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8550,http://localhost:8550

# --- IA (proveedor por decidir en ADR-003) ---
# La clave debe permanecer en el backend; jamás en el código de la interfaz ni en el repositorio.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=60

# --- Subida de archivos ---
MAX_UPLOAD_SIZE_MB=5
ALLOWED_IMAGE_EXTENSIONS=png,jpg,jpeg

# --- Datos de demostración ---
# Contraseña de las cuentas creadas por scripts/seed_demo_data.py. No usar en producción.
DEMO_USER_PASSWORD=cambiar-esto

# --- Frontend (Flet) ---
API_BASE_URL=http://127.0.0.1:8000
